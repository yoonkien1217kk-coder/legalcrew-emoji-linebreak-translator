# Slack App Credentials에서 발급됩니다. 실제 값은 저장소에 커밋하지 마세요.
SLACK_SIGNING_SECRET=

# 워크스페이스 설치 후 발급되는 xoxb- 토큰입니다.
SLACK_BOT_TOKEN=

# LegalCrew workspace ID
SLACK_TEAM_ID=T08B5H13A1G

# 처음 보는 커스텀 이모지를 유니코드 이모지로 분석할 때 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# 운영에서는 영구 볼륨 경로를 권장합니다.
DATA_FILE=./data/custom-emoji-map.json

# Railway는 PORT를 자동으로 제공합니다. 로컬 실행 기본값입니다.
PORT=3000
